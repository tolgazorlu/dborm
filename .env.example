# AI analiz paneli için gereklidir (Google Gemini).
# Anahtar https://aistudio.google.com/apikey adresinden alınır.
# Anahtar yoksa uygulama çalışır, yalnızca "AI analizi" sekmesi 501 döner —
# kural motoru, parser ve diyagram etkilenmez.
GOOGLE_GENERATIVE_AI_API_KEY=

# Opsiyonel: kullanılacak model (varsayılan: gemini-1.5-flash)
# AI_MODEL=gemini-1.5-flash
